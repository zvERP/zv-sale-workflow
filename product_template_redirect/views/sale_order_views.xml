<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_product_template_redirect" model="ir.ui.view">
        <field name="name">sale.order.form.product.template.redirect</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_id'][@context]" position="attributes">
                <attribute name="context" add="'open_product_template_from_document': True" separator=", " />
            </xpath>
        </field>
    </record>
</odoo>
