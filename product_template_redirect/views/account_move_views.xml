<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_product_template_redirect" model="ir.ui.view">
        <field name="name">account.move.form.product.template.redirect</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id'][@context]" position="attributes">
                <attribute name="context" add="'open_product_template_from_document': True" separator=", " />
            </xpath>
            <xpath expr="//field[@name='line_ids']//field[@name='product_id'][@context]" position="attributes">
                <attribute name="context" add="'open_product_template_from_document': True" separator=", " />
            </xpath>
        </field>
    </record>
</odoo>
