<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_estimated_collection_date" model="ir.ui.view">
        <field name="name">sale.order.form.estimated.collection.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="estimated_collection_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_estimated_collection_calendar" model="ir.ui.view">
        <field name="name">sale.order.calendar.estimated.collection.date</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <calendar
                string="Calendario cobros estimados"
                date_start="estimated_collection_date"
                color="state"
                hide_time="true"
                event_limit="5"
                quick_add="False"
            >
                <field name="name"/>
                <field name="partner_id" avatar_field="avatar_128"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount_untaxed" widget="monetary"/>
                <field name="state" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>

    <record id="view_sale_order_estimated_collection_tree" model="ir.ui.view">
        <field name="name">sale.order.tree.estimated.collection.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="estimated_collection_date" string="Fecha estimada de cobro" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_estimated_collection_search" model="ir.ui.view">
        <field name="name">sale.order.search.estimated.collection.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='Group By']" position="inside">
                <filter
                    string="Mes cobro estimado"
                    name="group_by_estimated_collection_month"
                    domain="[]"
                    context="{'group_by': 'estimated_collection_date:month'}"
                />
            </xpath>
        </field>
    </record>

    <record id="action_sale_order_estimated_collection_calendar" model="ir.actions.act_window">
        <field name="name">Calendario cobros estimados</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="view_id" ref="view_sale_order_estimated_collection_calendar"/>
        <field name="domain">[('estimated_collection_date', '!=', False), ('invoice_status', '!=', 'invoiced')]</field>
        <field name="search_view_id" ref="view_sale_order_estimated_collection_search"/>
        <field name="context">{'create': False, 'search_default_group_by_estimated_collection_month': 1}</field>
    </record>

    <record id="action_sale_order_estimated_collection_calendar_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_sale_order_estimated_collection_calendar"/>
        <field name="act_window_id" ref="action_sale_order_estimated_collection_calendar"/>
    </record>

    <record id="action_sale_order_estimated_collection_calendar_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_sale_order_estimated_collection_tree"/>
        <field name="act_window_id" ref="action_sale_order_estimated_collection_calendar"/>
    </record>

    <record id="action_sale_order_estimated_collection_calendar_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale.view_order_form"/>
        <field name="act_window_id" ref="action_sale_order_estimated_collection_calendar"/>
    </record>

    <menuitem
        id="menu_sale_order_estimated_collection_calendar"
        name="Calendario cobros estimados"
        parent="sale.sale_order_menu"
        action="action_sale_order_estimated_collection_calendar"
        groups="sales_team.group_sale_salesman"
        sequence="30"
    />
</odoo>
